# Copy this file to .env and fill in real values before deploying to production.

FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-string

# Database (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///instance/lsc.db
# Example for Postgres: postgresql://user:password@host:5432/lsc

COMPANY_NAME=Les Starry Corporate
COMPANY_EMAIL=hello@lsc.com
COMPANY_PHONE=+234 800 000 0000
CURRENCY_SYMBOL=$

# Payment gateway keys (wire up in app/blueprints/cart/routes.py when ready)
PAYSTACK_PUBLIC_KEY=
STRIPE_PUBLIC_KEY=
